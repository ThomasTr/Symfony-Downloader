{
    "name": "thomastr/sfdownloader",
    "description": "Dockerized Symfony youtube-dl downloader with Mercure progress streaming",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "norkunas/youtube-dl-php": "^2.14.1",
        "symfony/asset": "^8.1.0",
        "symfony/asset-mapper": "^8.1.9",
        "symfony/console": "^8.1.9",
        "symfony/dotenv": "^8.1.6",
        "symfony/flex": "^2.11.0",
        "symfony/framework-bundle": "^8.1.9",
        "symfony/mercure-bundle": "^0.6.1",
        "symfony/messenger": "^8.1.9",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/runtime": "^8.1.9",
        "symfony/serializer": "^8.1.9",
        "symfony/stimulus-bundle": "^3.6.0",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/validator": "^8.1.9",
        "symfony/yaml": "^8.1.9"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.2",
        "symfony/browser-kit": "^8.1.9",
        "symfony/css-selector": "^8.1.6",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/phpunit-bridge": "^8.1.9",
        "symfony/stopwatch": "^8.1.0",
        "symfony/web-profiler-bundle": "^8.1.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "docker": true
        }
    }
}
